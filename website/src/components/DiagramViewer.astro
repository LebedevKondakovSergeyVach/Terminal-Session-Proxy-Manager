---
const t = Astro.locals.t;
---

<tspm-diagram-viewer data-pagefind-ignore>
	<template data-diagram-toolbar>
		<div class="diagram-toolbar">
			<span class="diagram-caption"></span>
			<button type="button" class="diagram-open diagram-button" aria-haspopup="dialog">
				<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M8 3H3v5M16 3h5v5M21 16v5h-5M8 21H3v-5M3 3l6 6M21 3l-6 6M21 21l-6-6M3 21l6-6" />
				</svg>
				{t('tspm.diagram.open')}
			</button>
		</div>
	</template>
	<dialog class="diagram-dialog not-content" aria-labelledby="diagram-title" aria-describedby="diagram-hint">
		<div class="diagram-heading">
			<h2 id="diagram-title">{t('tspm.diagram.title')}</h2>
			<button type="button" class="diagram-button diagram-icon-button" data-action="close" aria-label={t('tspm.diagram.close')} title={t('tspm.diagram.close')} autofocus>
				<svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 6 12 12M18 6 6 18" /></svg>
			</button>
		</div>
		<div class="diagram-controls" role="group" aria-label={t('tspm.diagram.controls')}>
			<button type="button" class="diagram-button diagram-icon-button" data-action="out" aria-label={t('tspm.diagram.zoomOut')} title={t('tspm.diagram.zoomOut')}>−</button>
			<button type="button" class="diagram-button diagram-icon-button" data-action="in" aria-label={t('tspm.diagram.zoomIn')} title={t('tspm.diagram.zoomIn')}>+</button>
			<button type="button" class="diagram-button" data-action="fit">{t('tspm.diagram.fit')}</button>
			<button type="button" class="diagram-button" data-action="actual" aria-label={t('tspm.diagram.actual')} title={t('tspm.diagram.actual')}>100%</button>
			<output class="diagram-scale" aria-live="polite" aria-atomic="true" aria-label={t('tspm.diagram.scale')}></output>
		</div>
		<p id="diagram-hint" class="diagram-hint">{t('tspm.diagram.hint')}</p>
		<div class="diagram-stage" tabindex="0" role="region" aria-label={t('tspm.diagram.pan')}>
			<div class="diagram-canvas"></div>
		</div>
	</dialog>
</tspm-diagram-viewer>

<script>
	import '../scripts/diagram-viewer';
</script>
